{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/ContentRevision",
  "$defs": {
    "ContentRevision": {
      "type": "object",
      "properties": {
        "content_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "revision": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "brand_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "text": {
          "type": "string"
        },
        "asset_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,63}$"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "brand_profile",
                  "offer",
                  "evidence",
                  "industry_pack"
                ]
              },
              "label": {
                "type": "string",
                "maxLength": 300
              },
              "checked_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              }
            },
            "required": [
              "source_id",
              "kind",
              "label"
            ],
            "additionalProperties": false
          }
        },
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,63}$"
              },
              "text": {
                "type": "string",
                "maxLength": 500
              },
              "kind": {
                "type": "string",
                "enum": [
                  "fact",
                  "price",
                  "availability",
                  "result",
                  "medical",
                  "guarantee",
                  "other"
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "supported",
                  "needs_verification",
                  "forbidden"
                ]
              },
              "evidence_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,63}$"
              }
            },
            "required": [
              "id",
              "text",
              "kind",
              "status"
            ],
            "additionalProperties": false
          }
        },
        "qa_result": {
          "$ref": "#/$defs/QaResult"
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "content_id",
        "revision",
        "brand_id",
        "text",
        "asset_ids",
        "source_refs",
        "claims",
        "qa_result",
        "hash"
      ],
      "additionalProperties": false,
      "description": "نسخهٔ immutable محتوا"
    },
    "QaResult": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "pass",
            "pass_with_warnings",
            "fail",
            "not_run"
          ]
        },
        "qa_version": {
          "type": "string"
        },
        "checked_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,63}$"
              },
              "severity": {
                "type": "string",
                "enum": [
                  "error",
                  "warning",
                  "info"
                ]
              },
              "passed": {
                "type": "boolean"
              },
              "message_fa": {
                "type": "string"
              },
              "excerpt": {
                "type": "string",
                "maxLength": 200
              }
            },
            "required": [
              "id",
              "severity",
              "passed",
              "message_fa"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "status",
        "qa_version",
        "checks"
      ],
      "additionalProperties": false,
      "description": "نتیجهٔ بازبینی خودکار؛ جایگزین تأیید انسانی نیست"
    }
  }
}
