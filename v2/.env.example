# نمونهٔ تنظیمات محیطی — بدون هیچ راز.
# این فایل را به .env.local کپی کنید و فقط مقدارهای غیرمحرمانه را تغییر دهید.
# رمزها، توکن‌ها و کلید اصلی هرگز در این پوشه ذخیره نمی‌شوند؛ در STUDIO_HOME (خارج از مخزن) ساخته می‌شوند.

# پروفایل اجرا: local (روی دستگاه مالک) یا server
STUDIO_PROFILE=local

# محل دادهٔ اجرا خارج از مخزن: کلید اصلی، رمزهای محلی پایگاه داده، دادهٔ PostgreSQL و دارایی‌ها.
# پیش‌فرض ویندوز: %LOCALAPPDATA%\ContentStudio   |  پیش‌فرض لینوکس: ~/.local/share/content-studio
# STUDIO_HOME=D:\ContentStudio

# درگاه‌ها (فقط روی 127.0.0.1 در پروفایل local)
STUDIO_API_PORT=4310
STUDIO_DASHBOARD_PORT=4300
STUDIO_PG_PORT=54329

# نشانی عمومی داشبورد؛ اگر https باشد کوکی نشست با Secure صادر می‌شود.
STUDIO_PUBLIC_URL=http://localhost:4300

# نمایش بنر «دادهٔ نمونه» و اجازهٔ seed برندهای نمونه
STUDIO_SAMPLE_DATA=true

# سطح log: debug | info | warn | error
STUDIO_LOG_LEVEL=info

# فقط پروفایل server: اتصال به PostgreSQL موجود. مقدار واقعی را از secret manager تزریق کنید، نه از فایل داخل مخزن.
# STUDIO_DATABASE_URL=
# STUDIO_MIGRATION_DATABASE_URL=
