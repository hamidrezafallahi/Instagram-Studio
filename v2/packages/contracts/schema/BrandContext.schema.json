{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/BrandContext",
  "$defs": {
    "BrandContext": {
      "type": "object",
      "properties": {
        "workspace_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "brand_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "revision": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "industry_pack": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,63}$"
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32
            }
          },
          "required": [
            "id",
            "version"
          ],
          "additionalProperties": false
        },
        "locale": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"
        },
        "audience": {
          "type": "object",
          "properties": {
            "summary": {
              "type": "string"
            },
            "segments": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "summary",
            "segments"
          ],
          "additionalProperties": false
        },
        "offers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Offer"
          }
        },
        "voice_rules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          }
        }
      },
      "required": [
        "workspace_id",
        "brand_id",
        "revision",
        "industry_pack",
        "locale",
        "audience",
        "offers",
        "voice_rules",
        "evidence_ids"
      ],
      "additionalProperties": false,
      "description": "تصویر نسخه‌دار دانش برند که به عامل‌ها داده می‌شود"
    },
    "Offer": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "kind": {
          "type": "string",
          "enum": [
            "service",
            "product",
            "course",
            "other"
          ]
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "sku": {
          "type": "string",
          "maxLength": 64
        },
        "price": {
          "$ref": "#/$defs/Money"
        },
        "price_checked_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "availability": {
          "type": "string",
          "enum": [
            "available",
            "limited",
            "unavailable",
            "unknown"
          ]
        },
        "evidence_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "is_sample": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "title",
        "kind"
      ],
      "additionalProperties": false,
      "description": "خدمت، کالا یا دورهٔ قابل ارائهٔ برند"
    },
    "Money": {
      "type": "object",
      "properties": {
        "amount_minor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "currency": {
          "type": "string",
          "enum": [
            "IRR",
            "IRT",
            "USD",
            "EUR"
          ]
        }
      },
      "required": [
        "amount_minor",
        "currency"
      ],
      "additionalProperties": false,
      "description": "مبلغ به واحد خرد (عدد صحیح) و ارز صریح"
    }
  }
}
