{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/PublicationTarget",
  "$defs": {
    "PublicationTarget": {
      "type": "object",
      "properties": {
        "connection_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "channel": {
          "type": "string",
          "enum": [
            "instagram",
            "linkedin",
            "website",
            "telegram",
            "whatsapp",
            "virgool",
            "ads"
          ]
        },
        "format": {
          "type": "string",
          "enum": [
            "post",
            "carousel",
            "story",
            "reel",
            "trial_reel",
            "text_post",
            "document",
            "article",
            "message",
            "ad_creative"
          ]
        },
        "destination_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "scheduled_at_utc": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "timezone": {
          "type": "string",
          "minLength": 3,
          "maxLength": 64
        }
      },
      "required": [
        "connection_id",
        "channel",
        "format",
        "destination_id",
        "scheduled_at_utc",
        "timezone"
      ],
      "additionalProperties": false,
      "description": "یک مقصد انتشار؛ هر action دقیقاً یک مقصد دارد"
    }
  }
}
